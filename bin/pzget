#!/usr/bin/env bash
# pzget — graphical app/webapp installer menu (fuzzel dmenu).
#
# Organised by source (omarchy-style, catalog only — no package searching):
#   📦 Arch (oficial)  ·  📥 AUR  ·  🌐 Apps web  ·  ➕ Crear app web
# Pick a source -> pick an app -> it installs automatically. Installed items
# are marked with a check.
set -uo pipefail

BIN_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
CATALOG="$BIN_DIR/pzget-catalog"
WEBAPP_ADD="$BIN_DIR/pzget-webapp-add"
PKG_PICK="$BIN_DIR/pzget-pkg-pick"
PKG_REMOVE="$BIN_DIR/pzget-pkg-remove"

# shellcheck source=/dev/null
. "$BIN_DIR/pzget-i18n"

# shellcheck source=/dev/null
. "$BIN_DIR/pzget-theme"

menu() { # prompt < lines-on-stdin -> selected line
  # --minimal-lines shrinks the window to the number of entries: a 5-item
  # menu was rendering in a box sized for ~15, with the rest empty.
  # --width 64 (was 52) stops the descriptions being truncated to "…".
  # Colours come from the desktop's live scheme; see pzget-theme.
  # shellcheck disable=SC2046
  fuzzel --dmenu \
    --prompt "$1 " \
    --width 64 \
    --minimal-lines \
    $(pzget_fuzzel_args) \
    2>/dev/null
}

# Open a floating terminal running a command, then pause so output is visible.
term_run() {
  local title="$1" cmd="$2"
  # Exit code 75 = "cancelled" -> close immediately; otherwise pause so the
  # user can read the output before the window closes.
  local wrapped="$cmd; __pz_rc=\$?; if [ \$__pz_rc -ne 75 ]; then printf '\n\033[1;32m[pzget]\033[0m $(t term_done)'; read -r; fi"
  # app-id "pzget" lets the WM float + center this window (see hypr rules).
  # Terminals ignore Hyprland's `size` rule, so we ask them to open at a modest
  # size directly (≈half the screen).
  if command -v kitty >/dev/null 2>&1; then
    setsid kitty --class pzget \
      -o remember_window_size=no -o initial_window_width=1280 -o initial_window_height=760 \
      --title "$title" bash -lc "$wrapped" >/dev/null 2>&1 &
  elif command -v foot >/dev/null 2>&1; then
    setsid foot --app-id pzget --window-size-pixels=1280x760 \
      --title "$title" bash -lc "$wrapped" >/dev/null 2>&1 &
  elif command -v xdg-terminal-exec >/dev/null 2>&1; then
    setsid xdg-terminal-exec bash -lc "$wrapped" >/dev/null 2>&1 &
  else
    echo "pzget: no supported terminal found" >&2; return 1
  fi
}

is_installed() { # source target -> 0 if installed
  case "$1" in
    repo|aur) pacman -Qq "$2" >/dev/null 2>&1 ;;
    webapp)
      local slug
      slug="$(echo "${WEBAPP_NAME:-}" | tr '[:upper:] ' '[:lower:]-' | tr -cd 'a-z0-9-')"
      [[ -f "$HOME/.local/share/applications/pzget-$slug.desktop" ]] ;;
    *) return 1 ;;
  esac
}

install_app() { # name source target
  local name="$1" source="$2" target="$3"
  case "$source" in
    repo)
      term_run "pzget · $name" "sudo pacman -S --needed --noconfirm '$target'" ;;
    aur)
      term_run "pzget · $name" "yay -S --needed --noconfirm --answerdiff=None --answerclean=None --removemake '$target'" ;;
    webapp)
      "$WEBAPP_ADD" --name "$name" --url "$target" --no-save >/dev/null ;;
    *) echo "pzget: unknown source '$source'" >&2; return 1 ;;
  esac
}

# List every app of a source and install the chosen one.
#
# Package sources (repo/aur) skip this entirely and jump straight to the fzf
# picker: having to pick the source, then scroll a curated list, then pick
# "search everything" was three steps to do one thing. The picker now shows
# the curated favourites at the top of the same list, so nothing is lost.
show_source() { # source title
  local source="$1" title="$2"
  declare -A ACTION=()
  local lines=""
  while IFS=$'\t' read -r name target desc; do
    [[ -z "$name" ]] && continue
    local label
    WEBAPP_NAME="$name"
    if is_installed "$source" "$target"; then
      label="$(printf '  ✓  %-20s  %s' "$name" "$(t installed)")"
    else
      label="$(printf '     %-20s  ·  %s' "$name" "$desc")"
    fi
    ACTION["$label"]="$name"$'\t'"$target"
    lines+="$label"$'\n'
  done < <("$CATALOG" source "$source")

  # Package sources also get the omarchy-style "search everything" picker.
  if [[ "$source" == repo || "$source" == aur ]]; then
    [[ -n "$lines" ]] && lines+="  ─────────────────────────────"$'\n'
    local s_label="  🔎  $(t search_pkg)"
    ACTION["$s_label"]="search"
    lines+="$s_label"$'\n'
  fi

  local chosen
  chosen="$(printf '%s' "$lines" | menu "$title »")"
  [[ -z "$chosen" ]] && return

  local act="${ACTION[$chosen]:-}"
  [[ -z "$act" ]] && return

  if [[ "$act" == "search" ]]; then
    term_run "pzget · $title" "$PKG_PICK $source"
    return
  fi

  IFS=$'\t' read -r a_name a_target <<<"$act"
  install_app "$a_name" "$source" "$a_target"
}

main_menu() {
  declare -A ACTION=()
  local lines=""
  add_entry() { # icon  name  blurb  action
    local label
    label="$(printf '  %s  %-15s  %s' "$1" "$2" "$3")"
    ACTION["$label"]="$4"
    lines+="$label"$'\n'
  }

  add_entry "📦" "$(t arch_name)" "$(t arch_blurb)" "src"$'\t'"repo"$'\t'"$(t arch_name)"
  add_entry "📥" "$(t aur_name)"  "$(t aur_blurb)"  "src"$'\t'"aur"$'\t'"$(t aur_name)"
  add_entry "🌐" "$(t web_name)"  "$(t web_blurb)"  "src"$'\t'"webapp"$'\t'"$(t web_name)"
  add_entry "➕" "$(t add_name)"  "$(t add_blurb)"  "add"
  add_entry "🗑️" "$(t remove_name)" "$(t remove_blurb)" "remove"

  local chosen
  chosen="$(printf '%s' "$lines" | menu "pzget »")"
  [[ -z "$chosen" ]] && exit 0

  local act="${ACTION[$chosen]:-}"
  [[ -z "$act" ]] && exit 0

  local kind="${act%%$'\t'*}"
  case "$kind" in
    add) "$WEBAPP_ADD" ;;
    remove) term_run "pzget · $(t remove_name)" "$PKG_REMOVE" ;;
    src)
      local rest source title
      rest="${act#src$'\t'}"
      source="${rest%%$'\t'*}"
      title="${rest#*$'\t'}"
      # repo/aur -> straight to the picker (one step, favourites included).
      # webapp keeps the list menu: there is nothing to "search all" there.
      if [[ "$source" == repo || "$source" == aur ]]; then
        term_run "pzget · $title" "$PKG_PICK $source"
      else
        show_source "$source" "$title"
      fi ;;
  esac
}

main_menu
