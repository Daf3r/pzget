#!/usr/bin/env bash
# pzget-pkg-remove — uninstall installed Arch/AUR packages via an fzf picker.
# Lists explicitly-installed packages and removes the chosen ones with
# `pacman -Rns`. Meant to run inside a terminal (pzget launches it for you).
set -uo pipefail

if ! command -v fzf >/dev/null 2>&1; then
  echo "pzget: fzf is required" >&2; exit 75
fi

# NOTE: fzf runs --preview through $SHELL (fish here), so keep it a plain
# command with no shell-specific syntax.
selection="$(
  pacman -Qqe 2>/dev/null | fzf \
    --multi \
    --prompt 'eliminar » ' \
    --header 'DESINSTALAR · Tab: marcar varios · Enter: eliminar · Esc: cancelar' \
    --preview 'pacman -Qi {1}' \
    --preview-window 'down:60%:wrap' \
    --bind 'alt-p:toggle-preview' \
    --color 'pointer:red,marker:red'
)"

[[ -z "$selection" ]] && exit 75   # cancelado -> cerrar la terminal

echo "Desinstalando: $(echo "$selection" | tr '\n' ' ')"
# shellcheck disable=SC2046
sudo pacman -Rns --noconfirm $(echo "$selection" | tr '\n' ' ')
