#!/usr/bin/env bash
# pzget-preview ACTION — fzf preview helper for pzget-pkg-remove.
# ACTION is "pkg:NAME" or "webapp:SLUG". Kept as a standalone executable so it
# works no matter which shell fzf uses to launch it (bash, fish, zsh…).
lang="${PZGET_LANG:-$(cat "$HOME/.config/pzget/lang" 2>/dev/null || echo es)}"
if [ "$lang" = en ]; then webapp_msg="Web app created with pzget"; else webapp_msg="Webapp creada con pzget"; fi

a="${1:-}"
case "$a" in
  pkg:*)    pacman -Qi "${a#pkg:}" 2>/dev/null || echo "${a#pkg:}" ;;
  webapp:*) echo "$webapp_msg (${a#webapp:})" ;;
  *)        : ;;
esac
