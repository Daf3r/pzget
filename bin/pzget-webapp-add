#!/usr/bin/env bash
# pzget-webapp-add — create a Chromium web app (.desktop + icon).
#
# Interactive (prompts via fuzzel and saves to your webapps.toml):
#   pzget-webapp-add
# Non-interactive (used by pzget for curated webapps, does NOT save to toml):
#   pzget-webapp-add --name "YouTube" --url "https://youtube.com" --no-save
#
# Flags:
#   --name NAME    web app display name
#   --url  URL     web address
#   --no-save      do not append to ~/.config/pzget/webapps.toml
set -euo pipefail

BIN_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
# shellcheck source=/dev/null
. "$BIN_DIR/pzget-i18n"

NAME=""
URL=""
SAVE=true

while [[ $# -gt 0 ]]; do
  case "$1" in
    --name) NAME="$2"; shift 2 ;;
    --url) URL="$2"; shift 2 ;;
    --no-save) SAVE=false; shift ;;
    *) echo "pzget-webapp-add: unknown arg '$1'" >&2; exit 2 ;;
  esac
done

prompt() { fuzzel --dmenu --prompt "$1 " --lines 0 2>/dev/null; }

[[ -z "$NAME" ]] && NAME="$(: | prompt "$(t q_name)")"
[[ -z "$NAME" ]] && { echo "$(t cancelled)" >&2; exit 1; }
[[ -z "$URL" ]] && URL="$(: | prompt "$(t q_url)")"
[[ -z "$URL" ]] && { echo "$(t cancelled)" >&2; exit 1; }

# Normalise URL (add scheme if missing).
[[ "$URL" =~ ^https?:// ]] || URL="https://$URL"

slug="$(echo "$NAME" | tr '[:upper:] ' '[:lower:]-' | tr -cd 'a-z0-9-')"
host="$(echo "$URL" | sed -E 's#^https?://([^/]+).*#\1#')"

icon_dir="$HOME/.local/share/pzget/icons"
apps_dir="$HOME/.local/share/applications"
mkdir -p "$icon_dir" "$apps_dir"

# Pick a chromium-family browser for --app mode.
chrome=""
for b in chromium brave google-chrome-stable microsoft-edge vivaldi; do
  if command -v "$b" >/dev/null 2>&1; then chrome="$b"; break; fi
done
if [[ -z "$chrome" ]]; then
  echo "pzget-webapp-add: no chromium-family browser found (needed for --app)" >&2
  exit 1
fi

# Fetch a high-quality icon (omarchy-style) and ALWAYS convert it to PNG, so
# launchers/notifications render it (many can't display .webp/.ico/.svg).
# Convert the downloaded file to a 256px PNG. Returns 0 on success.
to_png() { # src-file  dest.png
  local in="$1" out="$2"
  if command -v magick >/dev/null 2>&1; then
    magick "${in}[0]" -background none -resize '256x256>' "$out" 2>/dev/null
  elif command -v convert >/dev/null 2>&1; then
    convert "${in}[0]" -background none -resize '256x256>' "$out" 2>/dev/null
  elif command -v python3 >/dev/null 2>&1; then
    python3 - "$in" "$out" <<'PY' 2>/dev/null
import sys
from PIL import Image
im = Image.open(sys.argv[1]).convert("RGBA")
im.thumbnail((256, 256))
im.save(sys.argv[2], "PNG")
PY
  else
    return 1
  fi
  [[ -s "$out" ]]
}

icon_path="$chrome"   # fallback: the browser's own icon
if command -v curl >/dev/null 2>&1; then
  tmp="$(mktemp)"
  out="$icon_dir/$slug.png"
  for src in \
    "https://unavatar.io/$host?fallback=false" \
    "https://logo.clearbit.com/$host?size=256" \
    "https://icon.horse/icon/$host" \
    "https://www.google.com/s2/favicons?domain=$host&sz=128"; do
    if curl -fsL --max-time 12 "$src" -o "$tmp" 2>/dev/null && [[ -s "$tmp" ]]; then
      case "$(file -b --mime-type "$tmp" 2>/dev/null)" in
        image/*)
          rm -f "$icon_dir/$slug".*
          if to_png "$tmp" "$out"; then icon_path="$out"; break; fi
          ;;
      esac
    fi
  done
  rm -f "$tmp"
fi

desktop="$apps_dir/pzget-$slug.desktop"
cat >"$desktop" <<EOF
[Desktop Entry]
Version=1.0
Name=$NAME
Comment=Web app (pzget)
Exec=$chrome --app=$URL
Terminal=false
Type=Application
Icon=$icon_path
Categories=Network;X-Pzget-Webapp;
StartupNotify=true
EOF

if [[ "$SAVE" == true ]]; then
  cfg="$HOME/.config/pzget"
  mkdir -p "$cfg"
  store="$cfg/webapps.toml"
  # Escape double quotes for TOML.
  esc_name="${NAME//\"/\\\"}"
  {
    echo "[[webapps]]"
    echo "name = \"$esc_name\""
    echo "url = \"$URL\""
    echo
  } >>"$store"
fi

command -v notify-send >/dev/null 2>&1 && \
  notify-send -i "$icon_path" "pzget" "$(t created) $NAME" 2>/dev/null || true

echo "$desktop"
